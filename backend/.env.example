# ── Supabase ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ── Auth ──────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# ── Gemini AI (for Mitra voice responses) ─────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email / SMTP ───────────────────────────────────────────────
# HOW TO SET UP GMAIL:
#   1. Enable 2-Factor Authentication on your Google account
#      → myaccount.google.com → Security → 2-Step Verification
#   2. Create an App Password (NOT your regular Gmail password)
#      → myaccount.google.com → Security → 2-Step Verification → App passwords
#      → Select "Mail" + "Windows Computer" → Generate → copy the 16-char password
#   3. Paste values below (no quotes needed)
#
# If SMTP_USER / SMTP_PASS are not set, OTPs are printed to the server console
# so you can still test locally without setting up email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=SOLACE <noreply@solace.in>

# ── Frontend URL (used in password-reset links) ────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# ── Demo mode ─────────────────────────────────────────────────
# true = show made-up demo guardian members and chat messages.
# Leave false (or unset) in production so real users never see fake people.
DEMO_MODE=false
